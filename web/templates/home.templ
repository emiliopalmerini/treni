package templates

import (
	"github.com/emiliopalmerini/treni/internal/domain"
	"net/url"
)

templ StationPickerPage(hasStations bool) {
	@Layout("Pick Your Station") {
		<section class="picker">
			if hasStations {
				<h1>Add Station</h1>
				<p>Search for a station to add</p>
			} else {
				<h1>Your Station</h1>
				<p>Search for your station to get started</p>
			}
			@PickerSearchBox()
			if hasStations {
				<a href="/" class="back-link">Back to dashboard</a>
			}
		</section>
	}
}

templ PickerSearchBox() {
	<div class="search-box">
		<input
			type="text"
			name="q"
			placeholder="Search station..."
			autocomplete="off"
			hx-get="/api/search?mode=picker"
			hx-trigger="keyup changed delay:300ms"
			hx-target="#search-results"
			hx-include="this"
		/>
		<div id="search-results" class="search-results"></div>
	</div>
}

templ PickerSearchResults(stations []domain.Station, query string) {
	if len(stations) > 0 {
		<ul class="suggestions">
			for _, s := range stations {
				<li>
					<a
						hx-get={ "/api/pick-station?code=" + s.Code + "&name=" + url.QueryEscape(s.Name) }
						hx-swap="none"
						href="#"
					>
						<span class="station-name">{ s.Name }</span>
						<span class="station-code">{ s.Code }</span>
					</a>
				</li>
			}
		</ul>
	} else if query != "" {
		<div class="no-results">
			<p>No stations found</p>
		</div>
	}
}

templ DashboardPage(saved []domain.StationRef, activeCode string, station *domain.Station) {
	@Layout(station.Name) {
		<div class="station-tabs">
			for _, s := range saved {
				<div class={ "station-tab", templ.KV("active", s.Code == activeCode) }>
					<button
						class="station-tab-name"
						hx-get={ "/api/station/" + s.Code + "/content" }
						hx-target="#station-content"
						hx-swap="innerHTML"
						onclick="setActiveStationTab(this)"
					>
						{ s.Name }
					</button>
					<a
						class="station-tab-remove"
						hx-get={ "/api/remove-station?code=" + s.Code }
						hx-swap="none"
						href="#"
						title="Remove station"
					>
						&times;
					</a>
				</div>
			}
			if len(saved) < 5 {
				<a href="/add-station" class="station-tab add-tab">+</a>
			}
		</div>
		<div id="station-content">
			@StationContentPartial(station)
		</div>
		<script>
			function setActiveStationTab(btn) {
				document.querySelectorAll('.station-tab').forEach(t => t.classList.remove('active'));
				btn.closest('.station-tab').classList.add('active');
			}
		</script>
	}
}

templ SearchResults(stations []domain.Station, query string) {
	if len(stations) > 0 {
		<ul class="suggestions">
			for _, s := range stations {
				<li>
					<a href={ templ.SafeURL("/station/" + s.Code) }>
						<span class="station-name">{ s.Name }</span>
						<span class="station-code">{ s.Code }</span>
					</a>
				</li>
			}
		</ul>
	} else if query != "" {
		<div class="no-results">
			<p>No stations found. Try searching for a train number:</p>
			<a href={ templ.SafeURL("/train/" + query) } class="train-link">
				View train { query }
			</a>
		</div>
	}
}
